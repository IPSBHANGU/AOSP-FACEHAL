android_app {
    name: "MiLahainaVisionPrivate",
    srcs: ["src/**/*.java", "src/**/*.kt"],
    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "setup-wizard-lib",
        "setupcompat",
        "setupdesign",
        "vendor.milahaina.biometrics.face-V2-java",
    ],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    optimize: {
        enabled: false,
    },
    installable: false,
}

android_app_import {
    name: "MiLahainaVision",
    apk: ":MiLahainaVisionPrivate",
    privileged: true,
    vendor: true,
    required: [
        "privapp_whitelist_org.milahaina.vision.xml",
        "MiLahainaVisionOverlay",
    ],
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
}
